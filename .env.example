# Copy to .env. Replace every password/secret before use.
#
# This is the only environment template in the repository. A second copy under
# backend_v2/ used to disagree with it - opposite write gating, and a usable weak
# database password where this file had a placeholder - so there was no way to tell which
# one a reader was meant to trust.
#
# docker compose builds BDA_V2_DATABASE_URL, BDA_V2_REDIS_URL and
# BDA_V2_CELERY_BROKER_URL from the three passwords below. Change the passwords, not the
# URLs: a URL set here is not read by compose, so editing it silently does nothing.

BDA_V2_ENVIRONMENT=development
BDA_V2_POSTGRES_PASSWORD=replace-with-a-strong-database-password
BDA_V2_REDIS_PASSWORD=replace-with-a-strong-redis-password
BDA_V2_MINIO_ACCESS_KEY=bda-v2
BDA_V2_MINIO_SECRET_KEY=replace-with-a-strong-minio-secret
BDA_V2_JWT_SECRET=replace-with-at-least-32-random-characters

BDA_V2_MINIO_ENDPOINT=minio-v2:9000
BDA_V2_MINIO_PUBLIC_ENDPOINT=localhost:9002
BDA_V2_MINIO_REGION=us-east-1
BDA_V2_MINIO_BUCKET=bda-v2-artifacts

BDA_V2_COMPUTE_BACKEND=docker
BDA_V2_DOCKER_HOST=tcp://docker-daemon.example.internal:2376
BDA_V2_DOCKER_TLS_CA=/var/run/secrets/bda/docker/ca.pem
BDA_V2_DOCKER_TLS_CERT=/var/run/secrets/bda/docker/tls.pem
BDA_V2_DOCKER_TLS_KEY=/var/run/secrets/bda/docker/tls-key.pem

# Required when BDA_V2_COMPUTE_BACKEND=lsf. Both are site-specific and deliberately have
# no default: an unconfigured deployment must fail rather than aim at whichever cluster
# and scratch directory happened to be baked in.
BDA_V2_LSF_SSH_HOST=
BDA_V2_LSF_REMOTE_ROOT=
BDA_V2_LSF_SSH_USER=
# Only when the cluster's SSH is not on 22.
BDA_V2_LSF_SSH_PORT=22
BDA_V2_LSF_QUEUE=normal
# Supply exactly one credential. The password form is a file: reference and never an
# inline value, because environment variables are visible in `docker inspect` and to
# every child process.
BDA_V2_LSF_SSH_KEY_PATH=
BDA_V2_LSF_SSH_PASSWORD_REF=

# Each provider needs issuer (https), client_id, and a comma-separated redirect_uris
# allowlist, for example:
# {"campus":{"issuer":"https://idp.example.org","client_id":"bda","redirect_uris":"http://localhost:8080/auth/callback"}}
BDA_V2_OIDC_PROVIDERS_JSON={}

BDA_V2_LLM_DEFAULT_PROVIDER_REF=
BDA_V2_LLM_LOCAL_SECRET_DIR=/var/lib/bda/secrets
BDA_V2_EXTERNAL_RESEARCH_SOURCES_JSON={}
BDA_V2_OTEL_ENDPOINT=

BDA_V2_EXPOSE_DOCS=true
BDA_V2_WRITES_ENABLED=true

VITE_API_BASE=/api/v2
