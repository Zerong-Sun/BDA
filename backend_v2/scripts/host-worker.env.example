# Host-side compute worker configuration.
#
# The compute worker runs on the host rather than in a container because the route to
# the cluster is a host VPN that a container network namespace does not inherit.
#
# Copy to backend_v2/scripts/host-worker.env (gitignored) and fill in.
# Everything else is inherited from the repository .env.

# --- Infrastructure, as seen from the host ---------------------------------------
# The containers publish these on localhost; inside compose they use service names.
BDA_V2_DATABASE_URL=postgresql+psycopg://bda:CHANGE_ME@localhost:5433/bda_v2
BDA_V2_REDIS_URL=redis://:CHANGE_ME@localhost:6380/0
BDA_V2_CELERY_BROKER_URL=redis://:CHANGE_ME@localhost:6380/1
BDA_V2_MINIO_ENDPOINT=localhost:9002

# --- Compute target --------------------------------------------------------------
BDA_V2_COMPUTE_BACKEND=lsf
# A literal address, never an ~/.ssh/config alias. With a password reference the
# transport is paramiko, which does not read ssh_config: an alias resolves to nothing
# and the port/user here are the only ones it sees. paramiko also uses RejectPolicy,
# so [host]:port must already be in ~/.ssh/known_hosts.
BDA_V2_LSF_SSH_HOST=172.18.6.10
BDA_V2_LSF_SSH_PORT=18188
BDA_V2_LSF_SSH_USER=bda-user
BDA_V2_LSF_REMOTE_ROOT=/opt/bda/bda-v2
# The FALLBACK queue, used only for a node that names no queue of its own. It is not
# a default to submit through: this project requires the queue to be read from
# `bqueues` at submit time (4167123/4167124 were killed in PEND for inheriting another
# job's resources), and the hand-written preparers refuse to render a remembered one.
# Set it to whatever is currently correct, and expect nodes to override it.
BDA_V2_LSF_QUEUE=v3-64

# ssh: the worker stages inputs and retrieves outputs over SFTP, and the job never
# touches the network. Required here, because compute nodes have no route to MinIO.
BDA_V2_LSF_STAGING_MODE=ssh

# Credentials are read from a file, never from this env file or the process
# environment, both of which leak through `ps` and `docker inspect`.
#   umask 077 && printf %s 'THE_PASSWORD' > ~/.bda/lsf-password
# Use BDA_V2_LSF_SSH_KEY_PATH instead wherever the cluster accepts public keys.
BDA_V2_LSF_SSH_PASSWORD_REF=file:/run/secrets/bda-lsf-password
