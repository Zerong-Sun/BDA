  "modes": [
    {
      "id": "protein_binder",
      "title": "蛋白靶标设计",
      "purpose": "设计链A针对protein_seqs的B/C等目标",
      "required_inputs": [
        "经核对的分子输入文件及可用模型权重"
      ],
      "parameters": {
        "mode": "binder",
        "protein_seqs": "<reviewed_target_amino_acid_sequence>",
        "num_designs": 3,
        "num_cycles": 3
      },
      "bda_status": "declared",
      "output_checks": [
        "逐输入/模型/种子核对输出数量、原始置信度和输入序列SHA",
        "对比实际日志与请求参数，不用成功退出替代科学结果验证"
      ],
      "limitations": [
        "结构置信度不是实验结合/活性证据"
      ],
      "source_refs": [
        "registry",
        "upstream-0"
      ]
    },
