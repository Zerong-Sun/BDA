FROM node:22-alpine
WORKDIR /app
COPY --chown=node:node frontend/package.json frontend/package-lock.json* ./
RUN mkdir -p /app/node_modules && chown -R node:node /app
USER node
RUN npm ci || npm install
COPY --chown=node:node frontend .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
