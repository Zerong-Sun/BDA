        "x-bda-flag": "-ddg:mut_file",
        "x-bda-source": "https://docs.rosettacommons.org/docs/latest/cartesian-ddG",
        "x-bda-modes": [
          "cartesian_ddg"
        ]
      },
      "ddg_iterations": {
        "type": "integer",
        "default": 3,
        "title": "WT/突变采样迭代",
