        "x-bda-unit": "次",
        "x-bda-flag": "-ddg:iterations",
        "x-bda-source": "https://docs.rosettacommons.org/docs/latest/cartesian-ddG",
        "minimum": 1,
        "maximum": 100,
        "x-bda-modes": [
          "cartesian_ddg"
        ]
      },
      "ddg_cartesian": {
        "type": "boolean",
        "default": true,
        "title": "DDG Cartesian 优化",
