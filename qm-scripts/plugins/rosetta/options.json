        "x-bda-flag": "-ddg:cartesian",
        "x-bda-source": "https://docs.rosettacommons.org/docs/latest/cartesian-ddG",
        "enum": [
          true
        ],
        "x-bda-modes": [
          "cartesian_ddg"
        ]
      },
      "ddg_bb_neighbors": {
        "type": "integer",
        "default": 1,
        "title": "骨架邻居范围",
        "description": "围绕突变位置允许处理的序列邻居范围；不是空间半径。",
