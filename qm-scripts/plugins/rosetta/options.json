        "x-bda-flag": "-ddg:bbnbrs",
        "x-bda-source": "https://docs.rosettacommons.org/docs/latest/cartesian-ddG",
        "minimum": 0,
        "maximum": 10,
        "x-bda-modes": [
          "cartesian_ddg"
        ]
      },
      "ddg_dump_pdbs": {
        "type": "boolean",
        "default": true,
        "title": "保存 DDG 结构",
        "description": "保存 WT/突变模型供原子级核查；关闭则仅保存原始分数与日志。",
        "x-bda-unit": "无量纲",
        "x-bda-flag": "-ddg:dump_pdbs",
        "x-bda-source": "https://docs.rosettacommons.org/docs/latest/cartesian-ddG",
        "x-bda-modes": [
          "cartesian_ddg"
        ]
      },
      "fa_max_dis": {
        "type": "number",
        "default": 9.0,
        "title": "全原子作用距离截断",
