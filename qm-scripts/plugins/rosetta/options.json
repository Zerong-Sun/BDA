        "x-bda-unit": "Å",
        "x-bda-flag": "-fa_max_dis",
        "x-bda-source": "https://docs.rosettacommons.org/docs/latest/cartesian-ddG",
        "minimum": 3,
        "maximum": 20,
        "x-bda-modes": [
          "relax",
          "relax_interface",
          "InterfaceAnalyzer",
          "cartesian_ddg"
        ]
      },
      "parser_protocol": {
        "type": "string",
